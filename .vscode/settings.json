{
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "tests/non_regression",
        "-p",
        "*.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,
    "files.associations": {
        "deque": "cpp",
        "string": "cpp",
        "vector": "cpp"
    },
    "files.exclude": {
    "**/build": true,
    "**/install": true,
    "**/.git": true
  },
  "search.exclude": {
    "**/build": true,
    "**/install": true,
    "**/external": true,
    "**/third_party": true
  },
  "cmake.configureOnOpen": false,
  "cmake.automaticReconfigure": false

}
